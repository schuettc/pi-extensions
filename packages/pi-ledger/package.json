{
  "name": "pi-ledger",
  "version": "0.1.0",
  "description": "ledger for the pi coding agent: journal git/gh bash calls with the pi session, brief the session on its repo, sync in the background.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schuettc/pi-extensions.git",
    "directory": "packages/pi-ledger"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "git",
    "ledger"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test src/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "typescript": "^5.6.0"
  }
}
