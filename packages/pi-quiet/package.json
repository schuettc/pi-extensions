{
  "name": "pi-quiet",
  "version": "0.2.0",
  "description": "This rig's bash tool for the pi coding agent: calm one-line rendering (ctrl+o expands), pi's shell settings honoured, AGENT_SESSION_ID stamped per command from PI_SESSION_ID. Execution is still pi's built-in.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schuettc/pi-extensions.git",
    "directory": "packages/pi-quiet"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "tui",
    "tool-output",
    "quiet",
    "session-identity"
  ],
  "files": [
    "src",
    "!src/*.test.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0"
  }
}
