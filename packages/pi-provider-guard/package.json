{
  "name": "pi-provider-guard",
  "version": "0.1.0",
  "description": "A pi coding-agent extension that keeps pi off the metered anthropic provider and appends user-supplied harness policy prose to every turn.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schuettc/pi-extensions.git",
    "directory": "packages/pi-provider-guard"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "guardrails",
    "policy",
    "model-guard"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test src/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "typescript": "^5.6.0"
  }
}
