{
  "name": "pi-typesafe",
  "version": "0.1.0",
  "description": "Generic TypeSafe (Jev / System One) capability for the pi coding agent: agent-owned credential storage, a thin SDK client, and a question-bundle helper.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/schuettc/pi-extensions.git", "directory": "packages/pi-typesafe" },
  "keywords": ["pi-package", "pi-extension", "pi-coding-agent", "typesafe", "jev", "system-one"],
  "files": ["src", "README.md"],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": { "typecheck": "tsc --noEmit -p tsconfig.json", "test": "node --test src/*.test.ts" },
  "dependencies": { "@typesafe-ai/sdk": "^0.6.0" },
  "devDependencies": { "@earendil-works/pi-coding-agent": "^0.85.0", "typescript": "^5.6.0" }
}
